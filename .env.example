# AI Admissions Platform - Backend Environment Configuration
# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_NAME="AI Admissions Platform"
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://admissions:admissions@localhost:5432/admissions
DATABASE_URL_TEST=postgresql+psycopg://admissions:admissions@localhost:5432/admissions_test

# --- Security / Auth ---
JWT_SECRET_KEY=change-me-in-production-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Embeddings / RAG ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_DIMENSIONS=256
RAG_RELEVANCE_THRESHOLD=0.15
RAG_TOP_K=5
KNOWLEDGE_MAX_FILE_SIZE_MB=15

# --- AI Agent / LLM (future real provider; agent works fully without this) ---
AGENT_LLM_PROVIDER=mock
LLM_API_KEY=
AGENT_MAX_TOOL_CALLS_PER_TURN=6

# --- Future providers (not required for this stage) ---
STT_API_KEY=
TTS_API_KEY=
VOICE_PROVIDER_API_KEY=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Voice (Task 011): defaults to the deterministic mock provider - no
# credentials required for local development or tests. ---
STT_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_TRANSPORT_PROVIDER=mock
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=
VOICE_SESSION_MAX_DURATION_SECONDS=1800
VOICE_SESSION_IDLE_TIMEOUT_SECONDS=60
VOICE_MAX_CONCURRENT_SESSIONS_PER_COLLEGE=20

# --- Realtime web voice transport (Task 015) ---
# Set VOICE_TRANSPORT_PROVIDER=livekit and all three of these to use real
# LiveKit infrastructure. Leaving VOICE_TRANSPORT_PROVIDER=mock (default)
# requires none of them. In production, selecting "livekit" without all
# three set fails application startup rather than silently using mock.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600
